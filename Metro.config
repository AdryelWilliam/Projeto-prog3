const { getDefaultConfig } = require('expo/metro-config');

const config = getDefaultConfig(__dirname);

// Sobe o servidor (server.js) junto com o Expo: basta rodar "npx expo start"
try {
  require('./server.js');
} catch (e) {
  console.log('[servidor] Não foi possível iniciar:', e.message);
}

module.exports = config;